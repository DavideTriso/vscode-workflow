{
    "name": "vscode-extension-starter",
    "displayName": "VS Code Extension Starter",
    "description": "A minimal VS Code extension starter.",
    "version": "0.3.0",
    "publisher": "davidetriso",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/DavideTriso/vscode-workflow.git"
    },
    "private": true,
    "engines": {
        "vscode": "^1.105.0"
    },
    "categories": [
        "Other",
        "AI"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "tasks",
                    "title": "Tasks",
                    "icon": "media/sidebar.svg"
                }
            ]
        },
        "views": {
            "tasks": [
                {
                    "type": "webview",
                    "id": "tasks.list",
                    "name": "Tasks"
                }
            ]
        },
        "commands": [
            {
                "command": "vscode-workflow.registerClaudeCode",
                "title": "Workflow: Register Agents and Skills with Claude Code"
            }
        ],
        "configuration": {
            "title": "Workflow",
            "properties": {
                "vscode-workflow.tasks.requireProjectManagementUrl": {
                    "type": "boolean",
                    "default": true,
                    "description": "Require a project management URL when creating or editing a task. When disabled, the URL may be left empty; a URL that is entered must still be a valid http or https URL."
                },
                "vscode-workflow.user.email": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Email used to identify you in tasks (task creator, default assignee, assignee filter and time tracking). When empty, `git config user.email` is used."
                },
                "vscode-workflow.user.name": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Name used to identify you in tasks. When empty, `git config user.name` is used."
                },
                "vscode-workflow.teamMembers": {
                    "type": "array",
                    "default": [],
                    "markdownDescription": "Team members that can be selected as task assignee. You are always available as an assignee, even when not listed here.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "email": {
                                "type": "string",
                                "description": "Team member email."
                            },
                            "name": {
                                "type": "string",
                                "description": "Team member name."
                            }
                        },
                        "required": [
                            "email",
                            "name"
                        ],
                        "additionalProperties": false
                    }
                },
                "vscode-workflow.claudeCode.registration": {
                    "type": "string",
                    "enum": [
                        "ask",
                        "enabled",
                        "disabled"
                    ],
                    "default": "ask",
                    "enumDescriptions": [
                        "Ask once before adding the Workflow plugin to Claude Code.",
                        "Keep the Workflow plugin for Claude Code installed and up to date.",
                        "Never touch Claude Code settings."
                    ],
                    "description": "Controls whether the extension registers its agents and skills as a Claude Code plugin."
                }
            }
        }
    },
    "scripts": {
        "build": "node esbuild.mjs",
        "watch": "node esbuild.mjs --watch",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
        "test": "vitest run --passWithNoTests",
        "package": "npm run typecheck && npm test && node esbuild.mjs --production && vsce package",
        "vscode:uninstall": "node ./scripts/uninstall.js"
    },
    "devDependencies": {
        "@types/jsdom": "^21.1.7",
        "@types/node": "^22.0.0",
        "@types/vscode": "^1.105.0",
        "@vscode/vsce": "^3.0.0",
        "esbuild": "^0.25.0",
        "jsdom": "^26.1.0",
        "typescript": "^5.9.0",
        "vitest": "^3.2.0"
    }
}
