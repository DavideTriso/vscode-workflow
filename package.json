{
    "name": "vscode-extension-starter",
    "displayName": "VS Code Extension Starter",
    "description": "A minimal VS Code extension starter.",
    "version": "0.1.0",
    "publisher": "davidetriso",
    "license": "MIT",
    "private": true,
    "engines": {
        "vscode": "^1.105.0"
    },
    "categories": [
        "Other",
        "AI"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "tasks",
                    "title": "Tasks",
                    "icon": "media/sidebar.svg"
                }
            ]
        },
        "views": {
            "tasks": [
                {
                    "type": "webview",
                    "id": "tasks.list",
                    "name": "Tasks"
                }
            ]
        }
    },
    "scripts": {
        "build": "node esbuild.mjs",
        "watch": "node esbuild.mjs --watch",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
        "test": "vitest run --passWithNoTests",
        "package": "npm run typecheck && npm test && node esbuild.mjs --production && vsce package"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/vscode": "^1.105.0",
        "@vscode/vsce": "^3.0.0",
        "esbuild": "^0.25.0",
        "typescript": "^5.9.0",
        "vitest": "^3.2.0"
    }
}