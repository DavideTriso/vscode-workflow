{
    "name": "vscode-workflow",
    "displayName": "VS Code Workflow",
    "description": "Track tasks in VS Code and build with AI coding agents through a repeatable workflow. Every change is recorded in the repo, so agents and teammates, human or AI, keep the context they need.",
    "version": "0.8.2",
    "publisher": "davidetriso",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/DavideTriso/vscode-workflow.git"
    },
    "private": true,
    "engines": {
        "vscode": "^1.105.0"
    },
    "categories": [
        "Other",
        "AI"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "tasks",
                    "title": "Tasks",
                    "icon": "media/sidebar.svg"
                }
            ]
        },
        "views": {
            "tasks": [
                {
                    "type": "webview",
                    "id": "tasks.list",
                    "name": "Tasks"
                }
            ]
        },
        "commands": [
            {
                "command": "vscode-workflow.registerClaudeCode",
                "title": "Workflow: Register Agents and Skills with Claude Code"
            },
            {
                "command": "vscode-workflow.openHistoryEncryption",
                "title": "Workflow: Open History Encryption"
            },
            {
                "command": "vscode-workflow.generateCommitMessage",
                "title": "Workflow: Generate Commit Message",
                "icon": "$(sparkle)"
            }
        ],
        "configuration": {
            "title": "Workflow",
            "properties": {
                "vscode-workflow.tasks.requireProjectManagementUrl": {
                    "type": "boolean",
                    "default": true,
                    "description": "Require a project management URL when creating or editing a task. When disabled, the URL may be left empty; a URL that is entered must still be a valid http or https URL."
                },
                "vscode-workflow.user.email": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Email used to identify you in tasks (task creator, default assignee, assignee filter and time tracking). When empty, `git config user.email` is used."
                },
                "vscode-workflow.user.name": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Name used to identify you in tasks. When empty, `git config user.name` is used."
                },
                "vscode-workflow.teamMembers": {
                    "type": "array",
                    "default": [],
                    "markdownDescription": "Team members that can be selected as task assignee. You are always available as an assignee, even when not listed here.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "email": {
                                "type": "string",
                                "description": "Team member email."
                            },
                            "name": {
                                "type": "string",
                                "description": "Team member name."
                            }
                        },
                        "required": [
                            "email",
                            "name"
                        ],
                        "additionalProperties": false
                    }
                },
                "vscode-workflow.repositoryGroups": {
                    "type": "array",
                    "default": [],
                    "markdownDescription": "Groups of related repositories, such as a backend and its frontend. A task can be linked to tasks of its own repository and of every repository in the same group, and agents read the linked tasks as extra context. Repositories match by origin URL first, so links keep working on machines with other checkout paths.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "group": {
                                "type": "string",
                                "description": "User-friendly group name."
                            },
                            "repositories": {
                                "type": "array",
                                "description": "Repositories in this group.",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "path": {
                                            "type": "string",
                                            "description": "Absolute path of the local repository."
                                        },
                                        "originUrl": {
                                            "type": "string",
                                            "description": "URL of the upstream origin repository, for example https://github.com/org/repo."
                                        },
                                        "name": {
                                            "type": "string",
                                            "description": "User-friendly repository name, shown next to its tasks."
                                        },
                                        "description": {
                                            "type": "string",
                                            "description": "Short description of what the repository contains; given to agents as context."
                                        }
                                    },
                                    "required": [
                                        "path",
                                        "name"
                                    ],
                                    "additionalProperties": false
                                }
                            }
                        },
                        "required": [
                            "group",
                            "repositories"
                        ],
                        "additionalProperties": false
                    }
                },
                "vscode-workflow.relatedTasks.maxAgeDays": {
                    "type": "number",
                    "default": 90,
                    "minimum": 0,
                    "markdownDescription": "Maximum age in days of the tasks offered when linking related tasks. Older tasks are not listed; links that already exist are kept. Set to `0` to list tasks of any age."
                },
                "vscode-workflow.claudeCode.registration": {
                    "type": "string",
                    "enum": [
                        "ask",
                        "enabled",
                        "disabled"
                    ],
                    "default": "ask",
                    "enumDescriptions": [
                        "Ask once before adding the Workflow plugin to Claude Code.",
                        "Keep the Workflow plugin for Claude Code installed and up to date.",
                        "Never touch Claude Code settings."
                    ],
                    "description": "Controls whether the extension registers its agents and skills as a Claude Code plugin."
                },
                "vscode-workflow.commitMessage.claudePath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Full path of the `claude` executable that generates commit messages. When empty, `claude` on `PATH` is used, then the binary bundled with the Claude Code extension."
                },
                "vscode-workflow.commitMessage.maxDiffChars": {
                    "type": "number",
                    "default": 60000,
                    "minimum": 1000,
                    "markdownDescription": "Maximum number of diff characters sent to Claude when generating a commit message. A longer diff is cut and a diff summary is added."
                },
                "vscode-workflow.commitMessage.model": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Model that generates commit messages, for example `sonnet`. When empty, the Claude Code default is used."
                }
            }
        },
        "menus": {
            "scm/title": [
                {
                    "command": "vscode-workflow.generateCommitMessage",
                    "when": "scmProvider == git",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "build": "node esbuild.mjs",
        "watch": "node esbuild.mjs --watch",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
        "test": "vitest run --passWithNoTests",
        "package": "npm run typecheck && npm test && node esbuild.mjs --production && vsce package",
        "vscode:uninstall": "node ./scripts/uninstall.js"
    },
    "devDependencies": {
        "@types/jsdom": "^21.1.7",
        "@types/node": "^22.0.0",
        "@types/vscode": "^1.105.0",
        "@vscode/vsce": "^3.0.0",
        "esbuild": "^0.25.0",
        "jsdom": "^26.1.0",
        "typescript": "^5.9.0",
        "vitest": "^3.2.0"
    }
}